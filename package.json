{
  "name": "t3rra-c0d3-rhodes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "T3rra-C0d3-Rhodes：Windows 优先的 Tauri 2 coding-agent 控制台，使用 opencode ACP 与 ARK 族界面。",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build --config app/vite.config.ts",
    "dev:tauri": "vite --config app/vite.config.ts --host 127.0.0.1 --port 5191 --strictPort",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:demo": "node tools/check-demo.mjs",
    "check:traces": "node tools/check-traces.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "check:app": "node tools/check-app.mjs",
    "check:boundary": "node tools/check-boundary.mjs",
    "check:all": "npm run check && npm run test && npm run check:app && npm run check:boundary && npm run check:demo && npm run check:traces && npm run check:docs",
    "dev": "vite --config app/vite.config.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "jsdom": "^26.1.0",
    "vite": "^7.3.6",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0"
  }
}
