{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "T3rra-C0d3-Rhodes",
  "version": "0.1.0",
  "identifier": "com.t3rra.rhodes",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://127.0.0.1:5191",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "T3rra-C0d3-Rhodes — 作业记录",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
